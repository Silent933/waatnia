# ---- Database (PostgreSQL) ----
# Neon:  https://console.neon.tech  -> Connection string
# Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ---- Admin account (used by `npm run db:seed` only) ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-deploy"

# ---- Admin session signing key (REQUIRED in production) ----
# 32+ random bytes. Generate with:  openssl rand -base64 32
# Rotating this value signs every admin out.
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Public site URL (used for canonical links, sitemap, OpenGraph) ----
NEXT_PUBLIC_SITE_URL="https://waatnia.vercel.app"

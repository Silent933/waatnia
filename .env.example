# ============================================================
#  waatnia — environment variables
#  Copy the values into Vercel → Settings → Environment Variables.
#  This file is a template only; never put real secrets in it.
# ============================================================

# ---- Database (Supabase) ----
# Supabase Dashboard → Connect → Connection method: **Session pooler**
# The string must start with postgresql:// and END WITH :5432
# (NOT the "Transaction pooler" on :6543 — our checkout uses interactive
# transactions, which transaction-mode poolers do not support.)
#
# The pooler host contains a cluster index (aws-[N]-...) that cannot be
# guessed — copy it verbatim from the Connect dialog.
#   - username  : prisma.[PROJECT-REF]
#   - sslmode=require        → never connect unencrypted
#   - connection_limit=1     → Vercel serverless: one session per instance
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1"

# ---- Admin account ----
# The owner signs in with this password only — there is no email to type.
# Read by `npm run db:seed`, and only when the account does not already
# exist, so re-running never resets a password changed from /admin/settings.
# At least 12 characters. You can delete this var from Vercel once the
# first deploy succeeds.
ADMIN_PASSWORD="change-me-before-deploy"

# ---- Session signing key ----
# REQUIRED in production: the app refuses to start the admin area without it.
# Generate 32 random bytes and base64 them, e.g. in PowerShell:
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Fill($b)
#   [Convert]::ToBase64String($b)
# Rotating this value signs every admin out.
AUTH_SECRET="replace-with-32-random-bytes-base64"

# ---- Public site URL (canonical links, sitemap, OpenGraph) ----
NEXT_PUBLIC_SITE_URL="https://waatnia.sy"
